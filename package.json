{
  "name": "@rainbow/ui",
  "version": "0.1.0",
  "private": false,
  "description": "Framework-agnostic Web Components library built with Lit.",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json && vite build",
    "clean": "node ./tools/clean.mjs",
    "dev": "vite",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "setup:git-hooks": "node ./tools/install-git-hooks.mjs",
    "validate:branch": "sh ./tools/validate-branch.sh"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "oxfmt": "^0.16.0",
    "oxlint": "^1.83.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "happy-dom": "^18.0.1",
    "oxlint-tsgolint": "^7.0.2003"
  },
  "dependencies": {
    "lit": "^3.3.0"
  }
}
