#!/usr/bin/env sh
set -eu

message_file="$1"
message="$(sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$message_file" | head -n 1)"

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9][a-z0-9._/-]*\))?(!)?: [^[:space:]].{0,99}$'

if ! printf '%s\n' "$message" | grep -Eq "$pattern"; then
  printf '%s\n' 'ERROR: invalid commit message.' >&2
  printf '%s\n' 'Use Conventional Commits, for example: feat(button): add primary variant' >&2
  exit 1
fi
